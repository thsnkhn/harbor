    "Use one IP address or network range per line. If a refresh fails, the last valid list stays active." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una dirección IP o un rango de red por línea. Si una actualización falla, la última lista válida sigue activa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указывайте один IP-адрес или диапазон сети на строку. Если обновление не удастся, останется активным последний корректный список."
          }
        }
      }
    },
    "Use one word, with hyphens or underscores if needed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa una sola palabra, con guiones o guiones bajos si es necesario."
