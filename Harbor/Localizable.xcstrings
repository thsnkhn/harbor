    "download.browser.resumeAfterRelaunch" : {
      "comment" : "Status message shown when a browser-backed download can be resumed after relaunch.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Browser download progress is available. Continue in the browser to resume it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso de la descarga del navegador está disponible. Continúa en el navegador para reanudarla."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогресс загрузки в браузере доступен. Продолжите в браузере, чтобы возобновить её."
          }
        }
      }
    },
    "download.browser.writerQuiescenceUnavailable" : {
      "comment" : "Failure shown when WebKit does not acknowledge cancellation of an active browser download.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "WebKit did not confirm that the active browser download stopped. Harbor left its temporary file and recovery state untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit no confirmó que la descarga activa del navegador se detuviera. Harbor dejó intactos su archivo temporal y su estado de recuperación."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WebKit не подтвердил остановку активной загрузки в браузере. Harbor не тронул её временный файл и состояние восстановления."
          }
        }
      }
    },
    "download.completedHandoff.unavailable" : {
      "comment" : "Failure shown when a durable completed download package is temporarily inaccessible.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Harbor could not verify the completed download: %@"
          }
        },
        "es" : {
