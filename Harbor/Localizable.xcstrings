    "Requires a local helper. Use manual forwarding; automatic forwarding can cancel the browser download before you confirm it in Harbor." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere un asistente local. Usa el reenvío manual; el reenvío automático puede cancelar la descarga del navegador antes de que la confirmes en Harbor."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requer um auxiliar local. Use o reencaminhamento manual; o reencaminhamento automático pode cancelar a transferência do navegador antes de a confirmar no Harbor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется локальный помощник. Используйте ручную передачу: автоматическая может отменить загрузку в браузере до того, как вы подтвердите её в Harbor."
          }
        }
      }
    },
    "Restart your agent to load the skill. CLI access stays under your control." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicia tu agente para cargar la habilidad. El acceso desde la línea de comandos sigue bajo tu control."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reinicie o seu agente para carregar a skill. O acesso por linha de comandos permanece sob o seu controlo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапустите агента, чтобы загрузить навык. Доступ из командной строки остаётся под вашим контролем."
          }
        }
