    "Check existing files before downloading. You can choose what to do after the check." : {
      "comment": "Torrent file checking interface.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check existing files before downloading. You can choose what to do after the check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica los archivos existentes antes de descargar. Después podrás elegir qué hacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica i file esistenti prima di scaricare. Dopo la verifica puoi scegliere cosa fare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载前检查现有文件。检查后可以选择下一步操作。"
          }
        }
      }
    },
    "Harbor is checking the existing files. Downloads stay stopped until you choose an action." : {
      "comment": "Torrent file checking interface.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Harbor is checking the existing files. Downloads stay stopped until you choose an action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Harbor está verificando los archivos existentes. Las descargas seguirán detenidas hasta que elijas una acción."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Harbor sta verificando i file esistenti. I download restano fermi finché non scegli un’azione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Harbor 正在检查现有文件。在你选择操作前，下载将保持停止。"
          }
        }
      }
    },
